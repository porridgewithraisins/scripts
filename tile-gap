#!/usr/bin/env bash

# Place active window in a half/quarter of its monitor with a fixed gap
# Reserves space for any _NET_WM_WINDOW_TYPE_DOCK (xfce4-panel, etc.) on any edge
# usage: tile-gap {q,w,e,a,s,d,z,x,c}
# s: cycle max -> center A (3/5 x 2/3) -> center B (9/10 x 9/10) -> max -> ...
# a/d: pin left/right edge (inward resize), cycle width %
#      50..75 by 5, then 25..45 by 5, wrap to 50

set -euo pipefail

GAP=16
# center A: fractions of usable area (width, height)
CENTER_W_NUM=3
CENTER_W_DEN=5
CENTER_H_NUM=2
CENTER_H_DEN=3
# center B
CENTER_B_W_NUM=9
CENTER_B_W_DEN=10
CENTER_B_H_NUM=9
CENTER_B_H_DEN=10
# a/d width cycle (percent of usable mw)
SIDE_PCTS="50 55 60 65 70 75 25 30 35 40 45"
mx=
my=
mw=
mh=
wid=

# Shrink usable rect (mx,my,mw,mh) so it no longer overlaps dock (px,py,pw,ph)
# Dock is attached to the nearest monitor edge (panels can sit on any of the 4 sides)
reserve_dock() {
  px=$1
  py=$2
  pw=$3
  ph=$4

  p_right=$(( px + pw ))
  p_bottom=$(( py + ph ))
  m_right=$(( mx + mw ))
  m_bottom=$(( my + mh ))

  # no overlap, ignore
  (( px < m_right && p_right > mx && py < m_bottom && p_bottom > my )) || return 0
  # ignore stub/placeholder windows
  (( pw >= 20 && ph >= 20 )) || return 0

  p_cx=$(( px + pw / 2 ))
  p_cy=$(( py + ph / 2 ))
  d_top=$(( p_cy - my ))
  d_bottom=$(( m_bottom - p_cy ))
  d_left=$(( p_cx - mx ))
  d_right=$(( m_right - p_cx ))

  nearest=top
  best=$d_top
  if (( d_bottom < best )); then best=$d_bottom; nearest=bottom; fi
  if (( d_left < best )); then best=$d_left; nearest=left; fi
  if (( d_right < best )); then best=$d_right; nearest=right; fi

  case $nearest in
    top)
      mh=$(( mh - (p_bottom - my) ))
      my=$p_bottom
      ;;
    bottom)
      mh=$(( py - my ))
      ;;
    left)
      mw=$(( mw - (p_right - mx) ))
      mx=$p_right
      ;;
    right)
      mw=$(( px - mx ))
      ;;
  esac

  # refuse nonsense if geometry went bad
  (( mw > 0 && mh > 0 )) || {
    echo "tile-gap: usable area collapsed after dock reserve" >&2
    exit 1
  }
}

# Set wid + usable mx/my/mw/mh for the active window's monitor (minus docks)
resolve_usable() {
  wid=$(xdotool getactivewindow)
  eval "$(xdotool getwindowgeometry --shell "$wid")"
  wx=$X
  wy=$Y
  ww=$WIDTH
  wh=$HEIGHT
  cx=$(( wx + ww / 2 ))
  cy=$(( wy + wh / 2 ))

  mx=
  my=
  mw=
  mh=
  while IFS= read -r line; do
    echo "$line" | grep -q ' connected' || continue
    if [[ $line =~ ([0-9]+)x([0-9]+)\+([-0-9]+)\+([-0-9]+) ]]; then
      omw=${BASH_REMATCH[1]}
      omh=${BASH_REMATCH[2]}
      omx=${BASH_REMATCH[3]}
      omy=${BASH_REMATCH[4]}
      if (( cx >= omx && cx < omx + omw && cy >= omy && cy < omy + omh )); then
        mx=$omx
        my=$omy
        mw=$omw
        mh=$omh
        break
      fi
    fi
  done < <(xrandr --current)

  if test -z "${mw:-}"; then
    echo "tile-gap: could not find monitor for active window" >&2
    exit 1
  fi

  while read -r dock_id px py pw ph; do
    xprop -id "$dock_id" _NET_WM_WINDOW_TYPE 2>/dev/null | grep -q DOCK || continue
    reserve_dock "$px" "$py" "$pw" "$ph"
  done < <(wmctrl -lG | awk '{print $1, $3, $4, $5, $6}')
}

apply_geom() {
  # x,y,w,h = desired *decorated* box inside usable area.
  # wmctrl -e size is client size; subtract frame so we don't cover the panel.
  fl=0
  fr=0
  ft=0
  fb=0
  # xprop: _NET_FRAME_EXTENTS(CARDINAL) = 2, 2, 34, 2  (no '#')
  ext=$(xprop -id "$wid" _NET_FRAME_EXTENTS 2>/dev/null | sed -n 's/.*= //p' | tr -d ',')
  if test -n "$ext"; then
    set -- $ext
    fl=${1:-0}
    fr=${2:-0}
    ft=${3:-0}
    fb=${4:-0}
  fi
  cw=$(( w - fl - fr ))
  ch=$(( h - ft - fb ))
  if (( cw < 1 )); then cw=1; fi
  if (( ch < 1 )); then ch=1; fi

  wmctrl -i -r "$wid" -b remove,maximized_vert,maximized_horz
  # some WMs: a single -e can drop Y when height grows a lot (q→a, e→d)
  # resize first, then move so the top edge keeps its gap
  wmctrl -i -r "$wid" -e "0,-1,-1,$cw,$ch"
  wmctrl -i -r "$wid" -e "0,$x,$y,-1,-1"
}

place() {
  col=$1
  row=$2
  cols=$3
  rows=$4

  resolve_usable

  cell_w=$(( mw / 2 ))
  cell_h=$(( mh / 2 ))
  x=$(( mx + col * cell_w + GAP ))
  y=$(( my + row * cell_h + GAP ))
  w=$(( cols * cell_w - 2 * GAP ))
  h=$(( rows * cell_h - 2 * GAP ))

  apply_geom
}

# max -> A -> B -> max (size match within 40px); other geometries -> max
toggle_s() {
  resolve_usable

  aw=$(( mw * CENTER_W_NUM / CENTER_W_DEN ))
  ah=$(( mh * CENTER_H_NUM / CENTER_H_DEN ))
  bw=$(( mw * CENTER_B_W_NUM / CENTER_B_W_DEN ))
  bh=$(( mh * CENTER_B_H_NUM / CENTER_B_H_DEN ))

  dw=$(( ww - aw ))
  dh=$(( wh - ah ))
  if (( dw < 0 )); then dw=$(( -dw )); fi
  if (( dh < 0 )); then dh=$(( -dh )); fi
  near_a=0
  if (( dw <= 40 && dh <= 40 )); then near_a=1; fi

  if xprop -id "$wid" _NET_WM_STATE 2>/dev/null | grep -q _NET_WM_STATE_MAXIMIZED; then
    w=$aw
    h=$ah
    x=$(( mx + (mw - w) / 2 ))
    y=$(( my + (mh - h) / 2 ))
    apply_geom
  elif (( near_a )); then
    w=$bw
    h=$bh
    x=$(( mx + (mw - w) / 2 ))
    y=$(( my + (mh - h) / 2 ))
    apply_geom
  else
    # near B, or anything else
    wmctrl -i -r "$wid" -b add,maximized_vert,maximized_horz
  fi
}

# left|right: pin outer edge (grow/shrink inward), cycle SIDE_PCTS by nearest width
cycle_lr() {
  side=$1
  resolve_usable

  # nearest step to current width (apps may clamp min width past our target)
  n=0
  for _ in $SIDE_PCTS; do n=$(( n + 1 )); done
  i=0
  found=0
  best=99999
  for pct in $SIDE_PCTS; do
    ew=$(( mw * pct / 100 - 2 * GAP ))
    dw=$(( ww - ew ))
    if (( dw < 0 )); then dw=$(( -dw )); fi
    if (( dw < best )); then
      best=$dw
      found=$i
    fi
    i=$(( i + 1 ))
  done
  # if nowhere near a step, start at 50; else advance
  if (( best > 80 )); then
    idx=0
  else
    idx=$(( (found + 1) % n ))
  fi

  i=0
  for pct in $SIDE_PCTS; do
    if (( i == idx )); then
      break
    fi
    i=$(( i + 1 ))
  done

  w=$(( mw * pct / 100 - 2 * GAP ))
  h=$(( mh - 2 * GAP ))
  y=$(( my + GAP ))
  if test "$side" = left; then
    x=$(( mx + GAP ))
  else
    x=$(( mx + mw - GAP - w ))
  fi
  apply_geom
  # min-width apps keep a larger client w; re-pin decorated right edge on this monitor
  if test "$side" = right; then
    eval "$(xdotool getwindowgeometry --shell "$wid")"
    fl=0
    fr=0
    ext=$(xprop -id "$wid" _NET_FRAME_EXTENTS 2>/dev/null | sed -n 's/.*= //p' | tr -d ',')
    if test -n "$ext"; then
      set -- $ext
      fl=${1:-0}
      fr=${2:-0}
    fi
    x=$(( mx + mw - GAP - WIDTH - fl - fr ))
    if (( x < mx + GAP )); then x=$(( mx + GAP )); fi
    wmctrl -i -r "$wid" -e "0,$x,$y,-1,-1"
  fi
}

case "${1:-}" in
  q) place 0 0 1 1 ;;
  w) place 0 0 2 1 ;;
  e) place 1 0 1 1 ;;
  a) cycle_lr left ;;
  s) toggle_s ;;
  d) cycle_lr right ;;
  z) place 0 1 1 1 ;;
  x) place 0 1 2 1 ;;
  c) place 1 1 1 1 ;;
  *)
    echo "usage: tile-gap {q,w,e,a,d,z,x,c,s}" >&2
    exit 1
    ;;
esac
