#! /usr/bin/env bash

set -euo pipefail

APP=io.github.nozwock.Packet

if ! busctl --user status "$APP" &>/dev/null; then
  packet --background &
  for _ in $(seq 1 50); do
    gdbus call --session \
      --dest "$APP" \
      --object-path /io/github/nozwock/Packet/Share \
      --method org.freedesktop.DBus.Peer.Ping &>/dev/null && break
    sleep 0.1
  done
fi

[[ $# -eq 0 ]] && exit 0

parts=()
for f in "$@"; do
  esc=${f//\'/\\\'}
  parts+=("'$esc'")
done
IFS=,; arr="${parts[*]}"; unset IFS

gdbus call --session \
  --dest "$APP" \
  --object-path /io/github/nozwock/Packet/Share \
  --method org.gtk.Actions.Activate \
  send-files \
  "[<[${arr}]>]" \
  "{}" >/dev/null
